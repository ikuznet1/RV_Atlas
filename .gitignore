# ───────────────────────────────────────────────────────────────────────────
# Data + generated outputs (downloaded from Zenodo, not stored in git)
# ───────────────────────────────────────────────────────────────────────────
./resources
dependencies/
output/
TOM/
snRV_ref.rds
index.txt

# ───────────────────────────────────────────────────────────────────────────
# R / Rscript runtime artifacts
# ───────────────────────────────────────────────────────────────────────────
Rplots.pdf
.Rhistory
.Rapp.history
.RData
.Rproj.user/
.Renviron

# WGCNA per-block cache files written next to scripts
.blockConsModsCached*

# ───────────────────────────────────────────────────────────────────────────
# Figure-run scaffolding (local development, not source)
# ───────────────────────────────────────────────────────────────────────────
.figure_run_backup/
.figure_run_logs/
omnipathr-log/

# ───────────────────────────────────────────────────────────────────────────
# Manuscript drafts and binaries
# Source manuscripts live in ./paper/; not tracked because of size + churn.
# Word lock files and editor backups also caught here.
# ───────────────────────────────────────────────────────────────────────────
paper/
RV_snRNASeq_v51/
RV_snRNASeq_v*.docx
RV_snRNASeq_v*.md
RV_snRNASeq_v*.pdf
RV_paper_revisions_responses.docx
*.docx.bak
*.docx.before_*
*.md.before_*
*.md.b*
~$*

# ───────────────────────────────────────────────────────────────────────────
# macOS / IDE / tooling
# ───────────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
CLAUDE.md
.claude/

# ───────────────────────────────────────────────────────────────────────────
# Companion app scaffolding kept out of figure-repro tree
# ───────────────────────────────────────────────────────────────────────────
shinyXenium/

# ───────────────────────────────────────────────────────────────────────────
# Conda/build lock files (machine-specific, not the source manifest)
# environment.yml and requirements.txt themselves should stay tracked.
# ───────────────────────────────────────────────────────────────────────────
*.osx_arm64_lock
*.linux_64_lock

# ───────────────────────────────────────────────────────────────────────────
# Large data staging / manual uploads (distributed via Zenodo, never via git)
# ───────────────────────────────────────────────────────────────────────────
zenodo_manual_upload/
dependencies_zenodo_staging/

# ───────────────────────────────────────────────────────────────────────────
# Local backups (renumber / figure-run snapshots)
# ───────────────────────────────────────────────────────────────────────────
.renumber_backup_*/

# ───────────────────────────────────────────────────────────────────────────
# Python runtime artifacts + run logs
# ───────────────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.pyc
*.log

# ───────────────────────────────────────────────────────────────────────────
# Mycelium / internal knowledge + working layer
# Kept private, consistent with CLAUDE.md and .claude/ above.
# ───────────────────────────────────────────────────────────────────────────
.living/
algorithms/
analysis/
data/
reference_material/
skillpacks/
todo/

# ───────────────────────────────────────────────────────────────────────────
# helper_scripts: publish only the canonical sourced helpers; the rest are
# exploratory scratch (draft_*, regen_*, replot_*, *_check.R, screens, pab_flow/).
# Add a new canonical helper with an explicit !whitelist line or `git add -f`.
# ───────────────────────────────────────────────────────────────────────────
helper_scripts/*
!helper_scripts/_shared_helpers.R
!helper_scripts/annotate_subnames.r
!helper_scripts/spatial_functions.R
